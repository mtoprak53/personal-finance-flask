# === DEVELOPMENT ENVIRONMENT ===

# FLASK
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# SECURITY (development için basit)
SECRET_KEY=dev-secret-key-for-local-development-only
SESSION_SECRET=dev-session-secret

# DATABASE
# DEV_DATABASE_URL=postgresql://finans_dev:dev123@localhost/finans_dev
# veya SQLite:
# DEV_DATABASE_URL=sqlite:///dev_finans.db

# EMAIL (development için console output)
MAIL_SERVER=localhost
MAIL_PORT=1025  # python -m smtpd -n -c DebuggingServer localhost:1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=

# LOGGING
LOG_LEVEL=DEBUG
LOG_FILE=logs/development.log

# FEATURES
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_DARK_MODE=true

# DEBUG TOOLS
DEBUG_TB_ENABLED=true
DEBUG_TB_INTERCEPT_REDIRECTS=false