# === TEMPLATE - Bu dosyayı kopyalayıp .env.{env} olarak kullanın ===
# BU DOSYAYI GİT'TE TUTUN

# FLASK
FLASK_ENV=development
FLASK_APP=app.py
FLASK_DEBUG=1

# SECURITY
SECRET_KEY=your-secure-secret-key-here-change-in-production
SESSION_SECRET=another-secret-for-sessions

# DATABASE - DEVELOPMENT
DEV_DATABASE_URL=postgresql://finans_dev:dev123@localhost/finans_dev

# DATABASE - TEST
TEST_DATABASE_URL=sqlite:///test_finans.db

# DATABASE - PRODUCTION (Railway/Heroku otomatik ekler)
# DATABASE_URL=postgresql://...

# EMAIL (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# CACHE
REDIS_URL=redis://localhost:6379/0

# APP SETTINGS
APP_NAME="Finans Takip"
APP_TIMEZONE="America/New_York"

# LOGGING
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# FEATURE FLAGS
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_DARK_MODE=true

# API KEYS (if needed)
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key