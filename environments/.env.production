# === PRODUCTION CONFIG TEMPLATE ===
# WARNING: This file contains ONLY placeholders!
# Real values are set in Railway Dashboard → Variables
# Never commit actual secrets to version control!

# FLASK
FLASK_ENV=production
FLASK_DEBUG=0

# SECURITY (Railway/Heroku'dan alınacak)
SECRET_KEY=${SECRET_KEY}  # Railway environment variable

# DATABASE (Railway otomatik ekler)
DATABASE_URL=${DATABASE_URL}

# EMAIL (SendGrid/Mailgun/etc)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=${SENDGRID_API_KEY}
MAIL_DEFAULT_SENDER=notifications@finansapp.com

# LOGGING
LOG_LEVEL=WARNING
LOG_FILE=/var/log/finans_app.log

# FEATURES
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_DARK_MODE=true

# SECURITY HEADERS
ENABLE_CSP=true
ENABLE_HSTS=true

# PERFORMANCE
WORKERS=4
THREADS=2
TIMEOUT=120