<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finans Takip Paneli</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    
    <!-- Favicon (isteğe bağlı) -->
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='images/favicon.ico') }}">
</head>

<body>
    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="fas fa-chart-line"></i>
            </div>
            <h4 class="brand-title">Finans Takip</h4>
            <p class="brand-subtitle">Kişisel Bütçe Yönetimi</p>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-item">
                <a href="#" class="nav-link active">
                    <i class="fas fa-home nav-icon"></i>
                    <span class="nav-text">Dashboard</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-wallet nav-icon"></i>
                    <span class="nav-text">Hesaplar</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-exchange-alt nav-icon"></i>
                    <span class="nav-text">İşlemler</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-chart-pie nav-icon"></i>
                    <span class="nav-text">Raporlar</span>
                </a>
            </div>
            <div class="nav-item">
                <a href="#" class="nav-link">
                    <i class="fas fa-cog nav-icon"></i>
                    <span class="nav-text">Ayarlar</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="total-balance-card">
                <div class="total-balance-label">Toplam Net Değer</div>
                <div class="total-balance-amount">$ {{ total_balance | default(0) }}</div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content animate-fadeIn">
        <!-- HEADER -->
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="page-title">Dashboard</h1>
                <p class="page-subtitle">Hoş geldiniz! Finansal durumunuzu takip edin.</p>
            </div>
            <div class="header-actions">
                <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addTransactionModal">
                    <i class="fas fa-plus me-2"></i>Yeni İşlem
                </button>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAccountModal">
                    <i class="fas fa-wallet me-2"></i>Yeni Hesap
                </button>
            </div>
        </div>

        <!-- STATISTICS CARDS -->
        <div class="stats-grid">
            <div class="stat-card balance-card">
                <div class="stat-header">
                    <div>
                        <div class="stat-label">Toplam Bakiye</div>
                        <div class="stat-value">$ {{ total_balance | default(0) }}</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-coins"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <span class="trend-up"><i class="fas fa-arrow-up me-1"></i> 12%</span>
                    <span class="text-muted">geçen aya göre</span>
                </div>
            </div>

            <div class="stat-card income-card">
                <div class="stat-header">
                    <div>
                        <div class="stat-label">Bu Ay Gelir</div>
                        <div class="stat-value">$ {{ monthly_income | default(0) }}</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-arrow-down"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <span class="trend-up"><i class="fas fa-arrow-up me-1"></i> 8 işlem</span>
                </div>
            </div>

            <div class="stat-card expense-card">
                <div class="stat-header">
                    <div>
                        <div class="stat-label">Bu Ay Gider</div>
                        <div class="stat-value">$ {{ monthly_expense | default(0) }}</div>
                    </div>
                    <div class="stat-icon">
                        <i class="fas fa-arrow-up"></i>
                    </div>
                </div>
                <div class="stat-trend">
                    <span class="trend-down"><i class="fas fa-arrow-up me-1"></i> 15 işlem</span>
                </div>
            </div>
        </div>

        <!-- CONTENT GRID -->
        <div class="row">
            <!-- ACCOUNTS SECTION -->
            <div class="col-lg-5 mb-4">
                <div class="accounts-section h-100">
                    <div class="section-header">
                        <h5 class="section-title">Hesaplarım</h5>
                        <span class="section-badge">{{ accounts|length }} hesap</span>
                    </div>
                    <div class="section-body">
                        {% if accounts %}
                            {% for acc in accounts %}
                            <div class="account-card">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="account-header">
                                        <div class="account-icon">
                                            <i class="fas fa-wallet"></i>
                                        </div>
                                        <div class="account-info">
                                            <h6>{{ acc.name }}</h6>
                                            <div class="account-currency">{{ acc.currency }}</div>
                                        </div>
                                    </div>
                                    <div class="account-balance">
                                        <div class="account-balance-amount">{% if acc.currency == 'USD' %}$ {{ acc.balance }}{% elif acc.currency == 'TRY' %}{{ acc.balance }} ₺{% else %}€ {{ acc.balance }}{% endif %}</div>
                                        <form action="{{ url_for('delete_account', id=acc.id) }}" method="POST"
                                            onsubmit="return confirm('Hesabı silmek istediğinize emin misiniz?');"
                                            class="d-inline">
                                            <button type="submit" class="account-delete-btn">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        {% else %}
                            <div class="no-data">
                                <div class="no-data-icon">
                                    <i class="fas fa-wallet"></i>
                                </div>
                                <p>Henüz hesap eklenmemiş</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- TRANSACTIONS SECTION -->
            <div class="col-lg-7">
                <div class="transactions-section">
                    <div class="section-header">
                        <h5 class="section-title">Son İşlemler</h5>
                        <a href="#" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
                    </div>
                    <div class="section-body">
                        {% if transactions %}
                        <div class="table-responsive">
                            <table class="transaction-table">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Açıklama</th>
                                        <th>Kategori</th>
                                        <th>Miktar</th>
                                        <th>İşlem</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for t in transactions %}
                                    <tr class="animate-slideIn">
                                        <td data-label="Tarih">
                                            <span class="date-day">{{ t.date.strftime('%d %b') }}</span>
                                            <span class="date-time">{{ t.date.strftime('%H:%M') }}</span>
                                        </td>
                                        <td data-label="Açıklama">
                                            <span class="transaction-title">{{ t.title }}</span>
                                            <span class="transaction-account">{{ t.account.name }}</span>
                                        </td>
                                        <td data-label="Kategori">
                                            <span class="category-badge">{{ t.category }}</span>
                                        </td>
                                        <td data-label="Miktar" class="{{ 'amount-income' if t.type == 'income' else 'amount-expense' }}">
                                            {{ '+' if t.type == 'income' else '-' }}{% if t.account.currency == 'USD' %}$ {{ t.amount }}{% elif t.account.currency == 'TRY' %}{{ t.amount }} ₺{% else %}€ {{ t.amount }}{% endif %}
                                        </td>
                                        <td data-label="İşlem" class="transaction-actions">
                                            <form action="{{ url_for('delete_transaction', id=t.id) }}" method="POST"
                                                onsubmit="return confirm('İşlemi silmek istediğinize emin misiniz?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% else %}
                        <div class="no-data">
                            <div class="no-data-icon">
                                <i class="fas fa-receipt"></i>
                            </div>
                            <p>Henüz işlem yok</p>
                        </div>
                        {% endif %}
                    </div>
                </div>

                <!-- QUICK STATS -->
                <div class="quick-stats">
                    <div class="quick-stat-card quick-stat-positive">
                        <div class="quick-stat-header">
                            <div>
                                <div class="quick-stat-label">En Çok Harcama</div>
                                <div class="quick-stat-value">{{ top_category | default('Yok') }}</div>
                            </div>
                            <div class="quick-stat-icon">
                                <i class="fas fa-chart-bar"></i>
                            </div>
                        </div>
                    </div>
                    
                    <div class="quick-stat-card {% if net_positive %}quick-stat-positive{% else %}quick-stat-negative{% endif %}">
                        <div class="quick-stat-header">
                            <div>
                                <div class="quick-stat-label">Aylık Net</div>
                                <div class="quick-stat-value">$ {{ monthly_net | default(0) }}</div>
                            </div>
                            <div class="quick-stat-icon">
                                <i class="fas fa-calculator"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: ADD ACCOUNT -->
    <div class="modal fade" id="addAccountModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Hesap Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/add_account" method="POST">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Hesap Adı</label>
                            <input type="text" name="name" class="form-control" placeholder="Örn: Akbank Vadeli" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Başlangıç Bakiyesi</label>
                            <input type="number" step="0.01" name="balance" class="form-control" placeholder="0.00" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Para Birimi</label>
                            <select name="currency" class="form-select">
                              <option value="USD" selected>USD - Amerikan Doları</option>
                              <option value="TRY">TRY - Türk Lirası</option>
                              <option value="EUR">EUR - Euro</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Hesap Oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL: ADD TRANSACTION -->
    <div class="modal fade" id="addTransactionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni İşlem Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/add_transaction" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">İşlem Tipi</label>
                                <select name="type" class="form-select" id="transactionType">
                                    <option value="expense">Gider</option>
                                    <option value="income">Gelir</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tutar</label>
                                <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <input type="text" name="title" class="form-control" placeholder="Örn: Market alışverişi" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kategori</label>
                                <input type="text" name="category" class="form-control" placeholder="Örn: Market" list="categories">
                                <datalist id="categories">
                                    <option>Market</option>
                                    <option>Fatura</option>
                                    <option>Kira</option>
                                    <option>Ulaşım</option>
                                    <option>Eğlence</option>
                                    <option>Maaş</option>
                                    <option>Freelance</option>
                                </datalist>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Hesap</label>
                                <select name="account_id" class="form-select" required>
                                    {% for acc in accounts %}
                                    <option value="{{ acc.id }}">{{ acc.name }} ({{ acc.balance }} {{ acc.currency }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tarih</label>
                            <input type="datetime-local" name="date" class="form-control" value="{{ now }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Notlar</label>
                            <textarea name="description" class="form-control" rows="2" placeholder="İsteğe bağlı notlar..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JavaScript (isteğe bağlı) -->
    <script src="{{ url_for('static', filename='js/main.js') }}"></script>
    
    <script>
        // Dinamik form güncelleme
        document.getElementById('transactionType').addEventListener('change', function() {
            const amountInput = document.querySelector('input[name="amount"]');
            const type = this.value;
            amountInput.placeholder = type === 'income' ? 'Gelir miktarı...' : 'Gider miktarı...';
        });

        // Auto-dismiss alerts
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                new bootstrap.Alert(alert).close();
            });
        }, 5000);

        // Tooltip'leri başlat
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
</body>
</html>